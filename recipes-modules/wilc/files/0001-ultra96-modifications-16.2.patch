@@ -1449,6 +1453,8 @@ struct wilc_vif *wilc_netdev_ifc_init(struct wilc *wl, const char *name,
 	vif = netdev_priv(ndev);
 	ndev->ieee80211_ptr = &vif->priv.wdev;
 	strcpy(ndev->name, name);
+
+	vif->primary_if = 0;
 	vif->wilc = wl;
 	vif->ndev = ndev;
 	ndev->ml_priv = vif;
@@ -1482,6 +1488,9 @@ struct wilc_vif *wilc_netdev_ifc_init(struct wilc *wl, const char *name,
 	list_add_tail_rcu(&vif->list, &wl->vif_list);
 	wl->vif_num += 1;
 	mutex_unlock(&wl->vif_mutex);
+
+	pr_info("wilc_netdev_ifc_init name[%s] vnum[%d], idx[%d], wilc-type[%d] nl-type[%d]\n", ndev->name, wl->vif_num, vif->idx, vif_type, type);
+
 	synchronize_srcu(&wl->srcu);
 
 	return vif;
